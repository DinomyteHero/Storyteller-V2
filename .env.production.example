# ============================================================================
# Storyteller AI — Production Environment Configuration
# ============================================================================
# Copy to .env and customize. All uncommented values below are REQUIRED
# or RECOMMENDED for production deployments.
#
# For local development, use .env.example instead (all defaults are fine).
# ============================================================================

# ── Security (REQUIRED) ─────────────────────────────────────────────────────
# Dev mode must be OFF in production
STORYTELLER_DEV_MODE=0

# Set a strong API token (generate with: openssl rand -hex 32)
STORYTELLER_API_TOKEN=CHANGE_ME_TO_A_RANDOM_TOKEN

# Restrict CORS to your actual frontend domain
STORYTELLER_CORS_ALLOW_ORIGINS=https://your-domain.com

# ── Database ─────────────────────────────────────────────────────────────────
STORYTELLER_DB_PATH=./data/storyteller.db
VECTORDB_PATH=./data/lancedb

# ── LLM Configuration ───────────────────────────────────────────────────────
# Default: Ollama (local). For cloud, set provider API keys and select a preset.
OLLAMA_BASE_URL=http://localhost:11434

# Per-role timeouts (seconds)
# STORYTELLER_NARRATOR_TIMEOUT=120
# STORYTELLER_DIRECTOR_TIMEOUT=120

# ── Cloud LLM Providers (V12.0) ─────────────────────────────────────────────
# Set any API key to enable that provider. Keys can also be managed in Settings UI.
# ANTHROPIC_API_KEY=sk-ant-your-key-here
# OPENAI_API_KEY=sk-your-key-here
# XAI_API_KEY=xai-your-key-here
# DEEPSEEK_API_KEY=your-key-here
# GOOGLE_API_KEY=your-key-here

# ── Feature Flags ────────────────────────────────────────────────────────────
ENABLE_BIBLE_CASTING=1
ENABLE_PROCEDURAL_NPCS=1
ENABLE_SUGGESTION_REFINER=1
ENABLE_CLOUD_BLUEPRINT=0
ENABLE_SCALE_ADVISOR=0
ENABLE_CHOICE_FALLBACKS=1
# ENABLE_PORTRAITS=0                    # Enable NPC portraits + location art

# ── Era Pack Validation ──────────────────────────────────────────────────────
# Set to 0 for strict validation in production (rejects incomplete era packs)
ERA_PACK_LENIENT_VALIDATION=0

# ── Data Paths ───────────────────────────────────────────────────────────────
STORYTELLER_DATA_ROOT=./data
# ERA_PACK_DIR=./data/static/era_packs

# ── Server Configuration ────────────────────────────────────────────────────
# STORYTELLER_HOST=0.0.0.0
# STORYTELLER_PORT=8000

# ── Rate Limiting ────────────────────────────────────────────────────────────
STORYTELLER_RATE_LIMIT_WINDOW=60
STORYTELLER_RATE_LIMIT_MAX=10
