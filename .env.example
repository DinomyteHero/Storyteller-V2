# ============================================================================
# Storyteller AI — Environment Configuration
# ============================================================================
# Copy this file to .env and adjust values as needed.
# All variables have sensible defaults; only change what you need.
#
# Documentation: docs/architecture.md
# ============================================================================

# ── Core Paths ──────────────────────────────────────────────────────────────
# STORYTELLER_DATA_ROOT=./data           # Root data directory
# STORYTELLER_DB_PATH=./data/storyteller.db  # SQLite database path
# VECTORDB_PATH=                         # LanceDB path (auto-resolves ./data/lancedb)
# ERA_PACK_DIR=./data/static/era_packs   # Era pack directory
# STORYTELLER_INGEST_ROOT=               # Override root for lore/style/manifests (portable deployment)
# SETTING_PACK_PATHS=                    # Semicolon-delimited custom setting pack roots

# ── Feature Flags ───────────────────────────────────────────────────────────
# ENABLE_BIBLE_CASTING=1                 # Era Pack deterministic NPC casting
# ENABLE_PROCEDURAL_NPCS=1               # Deterministic procedural NPC fallback
# ENABLE_SUGGESTION_REFINER=1            # LLM-based suggestion refinement
# ENABLE_CLOUD_BLUEPRINT=0               # Cloud LLM for campaign blueprint (requires cloud provider)
# ENABLE_SCALE_ADVISOR=0                 # Dynamic campaign scale advisor
# ENABLE_PORTRAITS=0                     # V11.0: Serve NPC/companion portraits + location key art
# ENABLE_CHOICE_FALLBACKS=1              # Show generic fallback choices when LLM fails (disable for LLM-only)

# ── LLM Provider ────────────────────────────────────────────────────────────
# Default: all roles use Ollama (local). No cloud API keys needed.
# Timeout for LLM requests (seconds):
# LLM_TIMEOUT=300
# OLLAMA_TIMEOUT=300

# ── Cloud LLM Providers (provider-agnostic) ──────────────────────────────────
# Storyteller supports 5 cloud providers. Set any API key to enable that provider.
# Presets auto-resolve to the best available provider based on configured keys.
#
# Supported providers:
#   Anthropic (Claude)   — ANTHROPIC_API_KEY=sk-ant-your-key-here
#   OpenAI (GPT)         — OPENAI_API_KEY=sk-your-key-here
#   xAI (Grok)           — XAI_API_KEY=xai-your-key-here
#   DeepSeek             — DEEPSEEK_API_KEY=your-key-here
#   Google (Gemini)      — GOOGLE_API_KEY=your-key-here
#
# API keys can also be set via the Settings UI (stored in backend DB).
#
# ── Cloud Presets ─────────────────────────────────────────────────────────────
# Select a preset when creating a campaign, or set in Settings UI.
#
# BUDGET   (~$0.01/turn) — Narrator only on cloud
# BALANCED (~$0.02/turn) — Director, Narrator, Choice Crafter, Mechanic on cloud
# QUALITY  (~$0.05/turn) — All narrative + strategic roles on cloud
# CLOUD_ALL (~$0.08/turn) — ALL roles on cloud (no Ollama required)
# DEEPSEEK (~$0.02/turn) — ALL roles on DeepSeek (affordable, no Ollama required)
#
# --- CLOUD_ALL preset (recommended for laptops without Ollama) ---
# Set one or more provider API keys above, then select "Cloud All" in Settings.
# All 28 LLM agent roles will use your cloud provider automatically.
#
# --- DEEPSEEK preset (affordable cloud alternative) ---
# Set DEEPSEEK_API_KEY above, then select "DeepSeek" in Settings.
# Uses DeepSeek V3 for most roles; DeepSeek R1 for narrative-critical roles.

# ── Per-Role Model Configuration ────────────────────────────────────────────
# Pattern: STORYTELLER_{ROLE}_PROVIDER=<provider>  (ollama, anthropic, openai, xai, deepseek, google)
# Pattern: STORYTELLER_{ROLE}_MODEL=<model_name>
# Override the LLM provider/model for a specific agent role.
#
# STORYTELLER_ARCHITECT_MODEL=qwen3:4b
# STORYTELLER_DIRECTOR_MODEL=mistral-nemo:latest
# STORYTELLER_NARRATOR_MODEL=mistral-nemo:latest
# STORYTELLER_CASTING_MODEL=qwen3:4b
# STORYTELLER_BIOGRAPHER_MODEL=qwen3:4b
# STORYTELLER_MECHANIC_MODEL=qwen3:8b
# STORYTELLER_CHOICE_CRAFTER_MODEL=qwen3:8b
# STORYTELLER_KG_EXTRACTOR_MODEL=qwen3:4b
# STORYTELLER_EMBEDDING_MODEL=nomic-embed-text
# STORYTELLER_CAMPAIGN_INIT_MODEL=qwen3:4b

# To use a custom Ollama base URL (e.g., remote server):
# STORYTELLER_DIRECTOR_BASE_URL=http://my-gpu-server:11434

# ── Embedding & RAG ────────────────────────────────────────────────────────
# EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# EMBEDDING_DIMENSION=384
# LORE_TABLE_NAME=lore_chunks
# STYLE_TABLE_NAME=style_chunks
# CHARACTER_VOICE_TABLE_NAME=character_voice_chunks
# BASE_STYLE_SOURCE=star_wars_base_style

# ── Universe & Rules ──────────────────────────────────────────────────────
# STORYTELLER_RULE_SYSTEM=storyteller_core  # Active rule system (file in data/static/rule_systems/)
# DEFAULT_SETTING_ID=star_wars_legends   # Default universe setting
# DEFAULT_PERIOD_ID=rebellion            # Default era/time period
# ERA_PACK_LENIENT_VALIDATION=1          # Allow WIP era packs with missing references
# Override setting-specific bypass methods (comma-separated):
# SETTING_BYPASS_METHODS=magic,potion,enchantment

# ── Authentication & Security ─────────────────────────────────────────────
# STORYTELLER_API_TOKEN=                 # API auth token (generate: openssl rand -hex 32). Disabled when empty.
# STORYTELLER_CORS_ALLOW_ORIGINS=        # Comma-separated allowed origins (defaults to localhost variants)

# ── Server Configuration ──────────────────────────────────────────────────
# STORYTELLER_HOST=0.0.0.0               # Backend bind address
# STORYTELLER_PORT=8000                  # Backend port
# STORYTELLER_UI_PORT=5173               # Frontend dev server port
# VITE_API_BASE_URL=http://localhost:8000  # Frontend API base URL (build-time for Docker)
# OLLAMA_BASE_URL=http://localhost:11434   # Ollama server URL

# ── Rate Limiting ────────────────────────────────────────────────────────
# STORYTELLER_RATE_LIMIT_WINDOW=60       # Rate limit window (seconds)
# STORYTELLER_RATE_LIMIT_MAX=10          # Max turn requests per window

# ── Development & Debugging ────────────────────────────────────────────────
# STORYTELLER_DEV_MODE=0                 # Enable dev mode (debug endpoints, relaxed auth)
# DEV_CONTEXT_STATS=0                    # Include RAG context stats in API response
# INGESTION_TAGGER_ENABLED=0             # Enable LLM-based ingestion tagging
# NPC_RENDER_ENABLED=0                   # Enable NPC portrait rendering
# MECHANIC_SEED=                         # Fixed seed for mechanic determinism (testing)
# ENCOUNTER_SEED=                        # Fixed seed for encounter determinism (testing)
# STORYTELLER_DUMMY_EMBEDDINGS=          # Use dummy embeddings (testing only)
